behs %>%
ggplot(aes(sex,novel_eat_latency, fill = group))+
geom_boxplot(outlier.shape = NA)+
geom_jitter(position = position_jitterdodge(jitter.width = 0.2, dodge.width = 0.75), size = 1.5) +
