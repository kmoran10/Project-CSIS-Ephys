n2 = sum(group == unique(group)[2]),
# T-test
t_test = list(t.test(max_MC_pA ~ group)),
t_stat = t_test[[1]]$statistic,
df = t_test[[1]]$parameter,
p_value = t_test[[1]]$p.value,
diff = mean2 - mean1,
ci_low = t_test[[1]]$conf.int[1],
ci_high = t_test[[1]]$conf.int[2],
# Cohen's d (manual calculation)
pooled_sd = sqrt(((n1-1)*sd1^2 + (n2-1)*sd2^2)/(n1 + n2 - 2)),
cohens_d = diff/pooled_sd,
.groups = "drop"
) %>%
select(-t_test)
rie2 %>%
na.omit() %>%
group_by(sex) %>%
summarise(
# Group stats
group1 = unique(group)[1],
mean1 = mean(max_MC_pA[group == unique(group)[1]]),
sd1 = sd(max_MC_pA[group == unique(group)[1]]),
n1 = sum(group == unique(group)[1]),
group2 = unique(group)[2],
mean2 = mean(max_MC_pA[group == unique(group)[2]]),
sd2 = sd(max_MC_pA[group == unique(group)[2]]),
n2 = sum(group == unique(group)[2]),
# T-test
t_test = list(t.test(max_MC_pA ~ group)),
t_stat = t_test[[1]]$statistic,
df = t_test[[1]]$parameter,
p_value = t_test[[1]]$p.value,
diff = mean2 - mean1,
ci_low = t_test[[1]]$conf.int[1],
ci_high = t_test[[1]]$conf.int[2],
# Cohen's d (manual calculation)
pooled_sd = sqrt(((n1-1)*sd1^2 + (n2-1)*sd2^2)/(n1 + n2 - 2)),
cohens_d = diff/pooled_sd,
.groups = "drop"
) %>%
select(-t_test)
